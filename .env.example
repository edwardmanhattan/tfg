# Endpoints for the tfg desktop client (copy to `.env`, never commit it).
# Real environment variables always win over this file.

# Minos REST base: full URL wins, else host with derived :8080/api/v1,
# else the hosted dev. This is the user you sign in with.
TFG_MINOS_HOST=https://api.tfg.development.crossnet.co.id/api/v1

# Poll-thread wire: HTTP URL selects live HTTP polling, unset selects
# file replay (see TFG_SCENARIO).
#TFG_BACKEND_URL=http://127.0.0.1:3000

# Replay scenario name under scenarios/ (when TFG_BACKEND_URL is unset):
# `surge` for the traffic demo, default is the clear canvas.
#TFG_SCENARIO=surge

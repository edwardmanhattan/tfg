<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>tfg third-party licenses</title>
  <style>
    body { font-family: sans-serif; max-width: 900px; margin: 2rem auto; }
    pre { white-space: pre-wrap; overflow-wrap: anywhere; }
  </style>
</head>
<body>
  <h1>tfg third-party licenses</h1>
  <p>This file lists the licenses of Rust dependencies used by tfg.</p>
  <h2>Licenses</h2>
  <ul>
    {{#each licenses}}
      <li>
        <h3>{{name}}</h3>
        <p>Used by:</p>
        <ul>
          {{#each used_by}}
            <li>{{crate.name}} {{crate.version}}</li>
          {{/each}}
        </ul>
        <pre>{{text}}</pre>
      </li>
    {{/each}}
  </ul>
</body>
</html>

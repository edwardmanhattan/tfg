    },
    {
      "$ref": "#/$defs/pairing_offer"
    },
    {
      "$ref": "#/$defs/pair_request"
    },
    {
      "$ref": "#/$defs/paired"
    },
    {
      "$ref": "#/$defs/device"
    },
    {
      "$ref": "#/$defs/device_list"
    },
    {
      "$ref": "#/$defs/whoami"
    },
    {
      "$ref": "#/$defs/rotation"
    },
    {
      "$ref": "#/$defs/display_hello"
    }
  ]
}

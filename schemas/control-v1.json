{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tfg.invalid/schemas/control-v1.json",
  "title": "TFG control protocol v2",
  "description": "Every JSON body in the TFG control protocol v2: commands posted to POST /v1/commands, the session projection published with PUT /v1/session, events pushed over GET /v1/ws, the display handshake a command center sends up that socket, the observer UI the phone sets, the pairing and device bodies, and the error reply. Hull pictures travel as image/png on GET/PUT /v1/units/{id}/picture and are not JSON. The prose contract is docs/control-api-v1.md; this file is its machine-readable shape.",
  "$defs": {
    "protocol_version": {
      "type": "integer",
      "const": 2
    },
    "geo_point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "center",
        "zoom",
        "width",
        "height"
      ],
      "properties": {
        "center": {
          "$ref": "#/$defs/geo_point"
        },
        "zoom": {
          "type": "number",
          "minimum": -30,
          "maximum": 30
        },
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "camera"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "camera": {
          "$ref": "#/$defs/camera"
        }
      }
    },
    "command": {
      "oneOf": [
        {
          "$ref": "#/$defs/command_camera_set"
        },
        {
          "$ref": "#/$defs/command_camera_nudge"
        },
        {
          "$ref": "#/$defs/command_camera_zoom"
        },
        {
          "$ref": "#/$defs/command_camera_focus"
        },
        {
          "$ref": "#/$defs/command_view_report"
        },
        {
          "$ref": "#/$defs/command_ui_set"
        },
        {
          "$ref": "#/$defs/command_settings_font"
        }
      ]
    },
    "command_settings_font": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "description": "The console's text size, as a step of its four-step ladder. Host-wide: it is not addressed to a view and needs no readiness.",
      "properties": {
        "protocol_version": {"$ref": "#/$defs/protocol_version"},
        "client_id": {"type": "string"},
        "command_id": {"type": "string"},
        "type": {"const": "settings.font"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["step"],
          "properties": {
            "step": {"type": "integer", "minimum": 0, "maximum": 3}
          }
        }
      }
    },
    "command_ui_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "protocol_version": {"$ref": "#/$defs/protocol_version"},
        "client_id": {"type": "string"},
        "command_id": {"type": "string"},
        "view": {"type": "string", "enum": ["observer"]},
        "type": {"const": "ui.set"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["panel", "open"],
          "properties": {
            "panel": {"type": "string", "enum": ["crew", "scenario", "comms"]},
            "open": {"type": "boolean"}
          }
        }
      }
    },
    "command_camera_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "payload"
      ],
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/protocol_version"
        },
        "client_id": {
          "type": "string",
          "maxLength": 64
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "view": {
          "type": "string",
          "maxLength": 32,
          "description": "Which view the command is about. Absent means `main`."
        },
        "type": {
          "const": "camera.set"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "center",
            "zoom"
          ],
          "properties": {
            "center": {
              "$ref": "#/$defs/geo_point"
            },
            "zoom": {
              "type": "number",
              "minimum": -30,
              "maximum": 30
            }
          }
        }
      }
    },
    "command_camera_nudge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "payload"
      ],
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/protocol_version"
        },
        "client_id": {
          "type": "string",
          "maxLength": 64
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "view": {
          "type": "string",
          "maxLength": 32,
          "description": "Which view the command is about. Absent means `main`."
        },
        "type": {
          "const": "camera.nudge"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dx_fraction",
            "dy_fraction"
          ],
          "properties": {
            "dx_fraction": {
              "type": "number",
              "minimum": -2,
              "maximum": 2
            },
            "dy_fraction": {
              "type": "number",
              "minimum": -2,
              "maximum": 2
            }
          }
        }
      }
    },
    "command_camera_zoom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "payload"
      ],
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/protocol_version"
        },
        "client_id": {
          "type": "string",
          "maxLength": 64
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "view": {
          "type": "string",
          "maxLength": 32,
          "description": "Which view the command is about. Absent means `main`."
        },
        "type": {
          "const": "camera.zoom"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "delta"
          ],
          "properties": {
            "delta": {
              "type": "number",
              "minimum": -10,
              "maximum": 10
            }
          }
        }
      }
    },
    "event": {
      "oneOf": [
        {
          "$ref": "#/$defs/event_snapshot"
        },
        {
          "$ref": "#/$defs/event_session_changed"
        },
        {
          "$ref": "#/$defs/event_camera_changed"
        },
        {
          "$ref": "#/$defs/event_command_accepted"
        },
        {
          "$ref": "#/$defs/event_command_rejected"
        },
        {
          "$ref": "#/$defs/event_display_attached"
        },
        {
          "$ref": "#/$defs/event_display_rejected"
        },
        {
          "$ref": "#/$defs/event_settings_changed"
        }
      ]
    },
    "event_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "revision",
        "views",
        "readiness"
      ],
      "properties": {
        "type": {
          "const": "snapshot"
        },
        "protocol_version": {
          "$ref": "#/$defs/protocol_version"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "views": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/view"
          },
          "required": [
            "main"
          ]
        },
        "session": {
          "$ref": "#/$defs/session"
        },
        "readiness": {
          "$ref": "#/$defs/readiness"
        },
        "displays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/display"
          }
        },
        "ui": {
          "$ref": "#/$defs/observer_ui"
        },
        "settings": {
          "$ref": "#/$defs/settings"
        }
      }
    },
    "event_camera_changed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "revision",
        "view"
      ],
      "properties": {
        "type": {
          "const": "camera.changed"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "type": "string"
        },
        "command_id": {
          "type": "string"
        },
        "view": {
          "$ref": "#/$defs/view"
        }
      }
    },
    "event_command_accepted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "command_id",
        "revision"
      ],
      "properties": {
        "type": {
          "const": "command.accepted"
        },
        "command_id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "event_command_rejected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "command_id",
        "code",
        "message"
      ],
      "properties": {
        "type": {
          "const": "command.rejected"
        },
        "command_id": {
          "type": "string"
        },
        "code": {
          "$ref": "#/$defs/error_code"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "$ref": "#/$defs/error_code"
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    },
    "command_view_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "payload"
      ],
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/protocol_version"
        },
        "client_id": {
          "type": "string",
          "maxLength": 64
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "view": {
          "type": "string",
          "maxLength": 32,
          "description": "Which view the command is about. Absent means `main`."
        },
        "type": {
          "const": "view.report"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8192
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8192
            }
          }
        }
      }
    },
    "scope": {
      "type": "string",
      "enum": [
        "observe",
        "control_view",
        "admin"
      ]
    },
    "error_code": {
      "type": "string",
      "enum": [
        "unauthorized",
        "forbidden",
        "invalid_json",
        "invalid_command",
        "unsupported_protocol",
        "body_too_large",
        "not_found",
        "host_gone",
        "too_many_clients",
        "server_error",
        "invalid_pairing_code",
        "no_pairing_window",
        "pairing_expired",
        "too_many_attempts",
        "unknown_device",
        "not_ready"
      ]
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "scopes",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^dev-[0-9a-f]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scope"
          },
          "minItems": 1
        },
        "created_at": {
          "type": "integer",
          "description": "Unix seconds."
        },
        "last_seen": {
          "type": "integer",
          "description": "Unix seconds; absent if never."
        }
      },
      "description": "A paired device as the API reports it. The stored token hash is never part of this shape."
    },
    "whoami": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client",
        "label",
        "scopes"
      ],
      "properties": {
        "client": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scope"
          }
        }
      }
    },
    "device_list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "devices"
      ],
      "properties": {
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/device"
          }
        }
      }
    },
    "pairing_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scope"
          },
          "description": "Defaults to observe + control_view. admin is refused: a paired device may not pair another."
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 600,
          "default": 120
        }
      },
      "description": "POST /v1/pairing, with the operator token."
    },
    "pairing_offer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "expires_in",
        "uri",
        "payload",
        "url",
        "scopes"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{4}-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "expires_in": {
          "type": "integer",
          "minimum": 1
        },
        "uri": {
          "type": "string",
          "pattern": "^tfg-control://pair\\?"
        },
        "payload": {
          "type": "string",
          "description": "The same offer as JSON, for a client that prefers to parse it."
        },
        "url": {
          "type": "string",
          "description": "The direct host base URL the offer points at; what a QR code or deep link hands a client without parsing the URI."
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scope"
          }
        }
      },
      "description": "The answer to POST /v1/pairing. url is the direct host base URL; uri and payload are the two shapes a QR code or deep link would carry; the server does not render an image."
    },
    "pair_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 8,
          "maxLength": 32
        },
        "label": {
          "type": "string",
          "maxLength": 48
        },
        "client_id": {
          "type": "string",
          "maxLength": 64
        }
      },
      "description": "POST /v1/pair. Unauthenticated: the code is the credential. Case, spaces and the dash do not matter."
    },
    "paired": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "token"
      ],
      "properties": {
        "device": {
          "$ref": "#/$defs/device"
        },
        "token": {
          "type": "string",
          "minLength": 32,
          "description": "Returned once and never again."
        },
        "url": {
          "type": "string"
        }
      },
      "description": "The answer to a successful POST /v1/pair."
    },
    "rotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "token"
      ],
      "properties": {
        "device": {
          "type": "string"
        },
        "token": {
          "type": "string"
        }
      },
      "description": "The answer to POST /v1/auth/rotate."
    },
    "command_camera_focus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "payload"
      ],
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/protocol_version"
        },
        "client_id": {
          "type": "string",
          "maxLength": 64
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "view": {
          "type": "string",
          "maxLength": 32
        },
        "type": {
          "const": "camera.focus"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit_id"
          ],
          "properties": {
            "unit_id": {
              "type": "integer",
              "minimum": 1
            },
            "zoom": {
              "type": "number",
              "minimum": -30,
              "maximum": 30
            }
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "step": {
          "type": "string"
        }
      }
    },
    "commander": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "unit_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "hull_number": {
          "type": "string"
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "id",
        "name"
      ],
      "description": "One hull a viewer may look at. `index` is the hub's array position, the number the phone grid and the command center marker share.",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string"
        },
        "hull_number": {
          "type": "string"
        },
        "class_name": {
          "type": "string"
        },
        "commander": {
          "$ref": "#/$defs/commander"
        },
        "embarked": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unit_ref"
          }
        },
        "embarked_in": {
          "$ref": "#/$defs/unit_ref"
        },
        "position": {
          "$ref": "#/$defs/geo_point"
        },
        "heading_deg": {
          "type": "number"
        },
        "speed_kn": {
          "type": "number"
        },
        "stale": {
          "type": "boolean"
        },
        "loa_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "beam_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "affiliation": {
          "type": "string",
          "enum": ["unknown", "friendly", "neutral", "hostile"]
        },
        "symbol": {
          "type": "string",
          "enum": ["dot", "destroyer", "frigate", "corvette", "auxiliary", "landing", "submarine", "plane", "tank", "port"]
        }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "name": {"type": "string"},
        "role": {"type": "string"},
        "judge": {"type": "boolean"},
        "ready": {"type": "boolean"}
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "description": "One message the console published for observers. `assumed` keeps the console's rule: a message sent as a scenario role has no author, and the projection never invents one.",
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "kind": {"type": "string"},
        "class_label": {"type": "string"},
        "sender": {"type": "string"},
        "assumed": {"type": "boolean"},
        "broadcast": {"type": "boolean"},
        "content": {"type": "string"},
        "at": {"type": "string"},
        "degree": {"type": "string"}
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "text_scale"],
      "description": "The host's text size: one setting, host-wide, that the console and every attached wall draw at.",
      "properties": {
        "step": {"type": "integer", "minimum": 0, "maximum": 3},
        "text_scale": {"type": "number", "minimum": 1.0, "maximum": 1.45}
      }
    },
    "event_settings_changed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "revision", "settings"],
      "description": "The host's text size changed. Every surface that draws type redraws at the new step.",
      "properties": {
        "type": {"const": "settings.changed"},
        "revision": {"type": "integer", "minimum": 0},
        "settings": {"$ref": "#/$defs/settings"}
      }
    },
    "observer_ui": {
      "type": "object",
      "additionalProperties": false,
      "description": "The observer's windows and the hull its popup is about. UI state, on the host so every attached wall agrees with the phone.",
      "properties": {
        "panels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "crew": {"type": "boolean"},
            "scenario": {"type": "boolean"},
            "comms": {"type": "boolean"}
          }
        },
        "focus": {"type": "integer", "minimum": 1}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "game_id",
        "name",
        "phase",
        "units"
      ],
      "description": "The console's projection of the exercise it holds. A projection: no credentials, and only the traffic the console itself may read. Hull pictures are fetched separately (GET /v1/units/{id}/picture).",
      "properties": {
        "game_id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string"
        },
        "phase": {
          "type": "string",
          "description": "The server's own word: planning, preparation, execution, closure. Only `execution` opens observation."
        },
        "mode": {
          "type": "string"
        },
        "scenario": {
          "$ref": "#/$defs/scenario"
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unit"
          }
        },
        "participants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/participant"
          }
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/message"
          }
        }
      }
    },
    "readiness_reason": {
      "type": "string",
      "enum": [
        "no_session",
        "not_execution",
        "no_display",
        "stale"
      ]
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready"
      ],
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "reason": {
          "$ref": "#/$defs/readiness_reason"
        }
      }
    },
    "display_viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "label": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "command_center"
          ]
        },
        "viewport": {
          "$ref": "#/$defs/display_viewport"
        }
      }
    },
    "display_hello": {
      "type": "object",
      "additionalProperties": false,
      "description": "Sent up the event stream by a display. The attachment dies with the socket, which is the fact the server needs. The admin scope is required: a paired phone cannot claim to be a command center.",
      "required": [
        "type",
        "role"
      ],
      "properties": {
        "type": {
          "const": "display.hello"
        },
        "id": {
          "type": "string",
          "maxLength": 48
        },
        "label": {
          "type": "string",
          "maxLength": 64
        },
        "role": {
          "type": "string",
          "enum": [
            "command_center"
          ]
        },
        "viewport": {
          "$ref": "#/$defs/display_viewport"
        }
      }
    },
    "event_session_changed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "revision",
        "readiness"
      ],
      "description": "The observation state changed: the session, its phase, its units, the readiness verdict, or which command centers are attached. One event because all of them answer one question.",
      "properties": {
        "type": {
          "const": "session.changed"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "session": {
          "$ref": "#/$defs/session"
        },
        "readiness": {
          "$ref": "#/$defs/readiness"
        },
        "displays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/display"
          }
        },
        "ui": {
          "$ref": "#/$defs/observer_ui"
        }
      }
    },
    "event_display_attached": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "const": "display.attached"
        },
        "id": {
          "type": "string"
        }
      }
    },
    "event_display_rejected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "code",
        "message"
      ],
      "properties": {
        "type": {
          "const": "display.rejected"
        },
        "code": {
          "$ref": "#/$defs/error_code"
        },
        "message": {
          "type": "string"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/command"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/error"
    },
    {
